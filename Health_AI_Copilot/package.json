{
  "name": "ai-health-copilot",
  "version": "1.0.0",
  "description": "AI-Powered Personal Health Copilot - 24-hour Hackathon Prototype for Paavai Demo Hospital",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "server": "node backend/server.js",
    "client": "npm --prefix frontend run dev",
    "dev": "concurrently -k -p \"[{name}]\" -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "seed": "node database/seed/seedData.js",
    "test": "node tests/runTests.js",
    "build": "npm --prefix frontend run build",
    "install:all": "npm install && npm --prefix frontend install"
  },
  "keywords": [
    "health-ai",
    "copilot",
    "ocr",
    "medical-records",
    "fhir",
    "abha",
    "hackathon"
  ],
  "author": "Paavai Demo Hospital Engineering Team",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
